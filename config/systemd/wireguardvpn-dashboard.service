[Unit]
Description=WireGuardVPN Ecuavisa - Technical Dashboard
After=network-online.target wg-quick@wg0.service wireguardvpn-firewall.service
Wants=network-online.target

[Service]
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
RestrictSUIDSGID=true
RestrictNamespaces=true
ProtectHostname=true
ProtectKernelLogs=true
PrivateDevices=true

# Security sandbox
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
LockPersonality=true
RestrictRealtime=true
UMask=0077

# Required writable state
ReadWritePaths=/etc/wireguard
ReadWritePaths=/srv/WireGuardVPN/config/peers
ReadWritePaths=/srv/WireGuardVPN/data/peers
ReadWritePaths=/srv/WireGuardVPN/logs
ReadWritePaths=/srv/WireGuardVPN/runtime
ReadWritePaths=/srv/WireGuardVPN/backups
Type=simple
User=wireguardvpn-dashboard
Group=wireguardvpn-dashboard
SupplementaryGroups=wireguardvpn-ops
WorkingDirectory=/srv/WireGuardVPN

ExecStart=/srv/WireGuardVPN/dashboard/.venv/bin/uvicorn \
    dashboard.app:app \
    --host 127.0.0.1 \
    --port 8095

Restart=on-failure
RestartSec=3

NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
