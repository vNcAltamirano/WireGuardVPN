[Unit]
Description=WireGuardVPN Ecuavisa - RBAC Firewall and Multi-LAN NAT
Documentation=file:/srv/WireGuardVPN/PROJECT_CONTEXT.md
Requires=wg-quick@wg0.service
After=wg-quick@wg0.service
PartOf=wg-quick@wg0.service

[Service]
Type=oneshot
ExecStart=/srv/WireGuardVPN/scripts/firewall_apply.sh
ExecReload=/srv/WireGuardVPN/scripts/firewall_apply.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
