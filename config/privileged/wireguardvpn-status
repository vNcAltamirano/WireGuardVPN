#!/usr/bin/env bash
set -euo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
    echo "ERROR: must run as root" >&2
    exit 77
fi

if [[ "$#" -ne 0 ]]; then
    echo "ERROR: this command accepts no arguments" >&2
    exit 64
fi

/usr/bin/wg show wg0 dump |
/usr/bin/awk -F '\t' '
BEGIN {
    OFS="\t"
}

NR == 1 {
    # Interface row.
    # Never expose the server private key.
    print "REDACTED", "REDACTED", $3, $4
    next
}

NF >= 8 {
    # Peer rows.
    # $2 is the preshared key and is intentionally removed.
    print $1, "REDACTED", $3, $4, $5, $6, $7, $8
}
'
